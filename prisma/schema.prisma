// ==========================================
// NEXT-AUTH REQUIRED MODELS
// ==========================================

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// USER & CORE AUTHENTICATION SECURITY
// ==========================================

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  phone        String?
  passwordHash String?
  avatarUrl    String?
  status       UserStatus    @default(PENDING)
  platformRole PlatformRole?

  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  vendorId      String?
  vendorRole    VendorUserRole?
  vendorProfile VendorProfile?  @relation("VendorEmployees", fields: [vendorId], references: [id], onDelete: SetNull)
  ownedVendor   VendorProfile?  @relation("VendorOwner")

  settings UserSettings?

  accounts Account[]
  sessions Session[]

  vendorApplications VendorApplication[]

  wishlistItems                      WishlistItem[]
  deliveryAddresses                  CustomerAddress[]
  recentlyViewed                     RecentlyViewed[]
  customerOrders                     Order[]                          @relation("CustomerOrders")
  reviewsWritten                     ProductReview[]
  shopReviewsWritten                 ShopReview[]
  reviewReplies                      ReviewReply[]
  reviewReports                      ReviewReport[]                   @relation("ReviewReporter")
  reviewReportsResolved              ReviewReport[]                   @relation("ReviewReportResolver")
  auditLogs                          AuditLog[]
  notifications                      Notification[]
  announcementStates                 AnnouncementUserState[]
  announcementsCreated               Announcement[]                   @relation("AnnouncementCreatedBy")
  announcementsPublished             Announcement[]                   @relation("AnnouncementPublishedBy")
  marketingNotificationStates        MarketingNotificationUserState[]
  marketingCampaignsCreated          MarketingNotificationCampaign[]  @relation("MarketingCampaignCreatedBy")
  marketingCampaignsPublished        MarketingNotificationCampaign[]  @relation("MarketingCampaignPublishedBy")
  devices                            UserDevice[]
  browserPushSubscriptions           BrowserPushSubscription[]
  subscriptionLifecycleIntents       SubscriptionLifecycleIntent[] @relation("SubscriptionLifecycleIntentActor")
  subscriptionBillingIntents         SubscriptionBillingIntent[] @relation("SubscriptionBillingIntentActor")
  pushDeliveryOutbox                 PushDeliveryOutbox[]
  returnRequests                     ReturnRequest[]                  @relation("ReturnRequester")
  refundsRequested                   Refund[]                         @relation("RefundRequester")
  refundsApproved                    Refund[]                         @relation("RefundApprover")
  disputesOpened                     Dispute[]                        @relation("DisputeCustomer")
  disputesResolved                   Dispute[]                        @relation("DisputeResolver")
  riskFlagsCreated                   RiskFlag[]                       @relation("RiskFlagCreator")
  riskFlagsResolved                  RiskFlag[]                       @relation("RiskFlagResolver")
  customerRiskFlags                  RiskFlag[]                       @relation("RiskFlagCustomer")
  marketplaceReportsFiled            MarketplaceReport[]              @relation("MarketplaceReportReporter")
  marketplaceReportsAssigned         MarketplaceReport[]              @relation("MarketplaceReportAssignee")
  marketplaceReportsAssignedBy       MarketplaceReport[]              @relation("MarketplaceReportAssignedBy")
  marketplaceReportsResolved         MarketplaceReport[]              @relation("MarketplaceReportResolver")
  marketplaceReportActivities        MarketplaceReportActivity[]      @relation("MarketplaceReportActivityActor")
  marketplaceReportNotes             MarketplaceReportNote[]          @relation("MarketplaceReportNoteAuthor")
  verificationApplicationsSubmitted  ShopVerificationApplication[]    @relation("ShopVerificationSubmittedBy")
  verificationApplicationsAssigned   ShopVerificationApplication[]    @relation("ShopVerificationAssignedAdmin")
  verificationApplicationsAssignedBy ShopVerificationApplication[]    @relation("ShopVerificationAssignedBy")
  verificationApplicationsDecided    ShopVerificationApplication[]    @relation("ShopVerificationDecisionBy")
  verificationActivities             ShopVerificationActivity[]       @relation("ShopVerificationActivityActor")
  verificationNotes                  ShopVerificationNote[]           @relation("ShopVerificationNoteAuthor")
  trialExtensions                    VendorTrialExtension[]            @relation("VendorTrialExtensionActor")

  @@index([status])
  @@index([vendorId])
  @@index([platformRole])
}

model CustomerAddress {
  id                   String   @id @default(uuid())
  customerId           String
  customer             User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label                String
  recipientName        String
  recipientPhone       String
  country              String   @default("Uganda")
  district             String
  city                 String
  area                 String
  street               String?
  building             String?
  landmark             String
  deliveryInstructions String?
  isDefault            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([customerId, updatedAt])
  @@index([customerId, isDefault])
}

model UserDevice {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId   String
  platform   DevicePlatform
  pushTokenEncrypted String
  pushTokenHash      String         @unique @db.VarChar(64)
  appVersion String?
  deviceName String?
  enabled    Boolean        @default(true)
  registrationVersion Int   @default(1)
  tokenUpdatedAt DateTime   @default(now())
  lastSuccessAt DateTime?
  lastFailureAt DateTime?
  failureCount Int          @default(0)
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  nativeDeliveries NativePushDelivery[]

  @@unique([userId, deviceId])
  @@index([userId, enabled])
}

model Promotion {
  id                String               @id @default(uuid())
  title             String
  subtitle          String?
  desktopImageUrl   String
  mobileImageUrl    String?
  status            PromotionStatus      @default(DRAFT)
  priority          Int                  @default(100)
  startsAt          DateTime?
  endsAt            DateTime?
  primaryCtaLabel   String?
  primaryCtaType    PromotionCtaType?
  primaryCtaValue   String?
  secondaryCtaLabel String?
  secondaryCtaType  PromotionCtaType?
  secondaryCtaValue String?
  placements        PromotionPlacement[]
  createdByUserId   String
  updatedByUserId   String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([status, priority])
}

model FeaturedProduct {
  id              String    @id @default(uuid())
  productId       String    @unique
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  priority        Int       @default(100)
  isActive        Boolean   @default(true)
  startsAt        DateTime?
  endsAt          DateTime?
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isActive, priority])
}

model FeaturedShop {
  id              String        @id @default(uuid())
  vendorId        String        @unique
  vendor          VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  priority        Int           @default(100)
  isActive        Boolean       @default(true)
  startsAt        DateTime?
  endsAt          DateTime?
  createdByUserId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([isActive, priority])
}

// ==========================================
// USER SETTINGS & PREFERENCES
// ==========================================

model UserSettings {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName    String?
  phoneNumber String?
  avatarUrl   String?

  currency         String  @default("UGX")
  primaryLanguage  String  @default("en")
  deliveryDistrict String?

  momoNetwork String?
  momoNumber  String?

  orderAlertsEmail              Boolean @default(true)
  orderAlertsPush               Boolean @default(true)
  securityAlertsSMS             Boolean @default(true)
  marketingNewsletter           Boolean @default(false)
  promotionalInAppNotifications Boolean @default(false)
  shoppingRecommendations       Boolean @default(false)
  promotionalPushNotifications  Boolean @default(false)

  twoFactorEnabled       Boolean @default(false)
  buyerProtectionEnabled Boolean @default(true)

  themeMode   String @default("system")
  accentColor String @default("classic")
  personality String @default("LOVELY")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ==========================================
// VENDOR KYC / ONBOARDING
// ==========================================

model VendorApplication {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Business Info
  storeName          String
  storeSlug          String  @unique
  businessType       String
  registrationNumber String?
  taxId              String?

  // Contact
  businessEmail String
  businessPhone String
  website       String?

  // Address
  streetAddress String
  city          String  @default("Kampala")
  district      String?
  country       String  @default("Uganda")
  postalCode    String?

  // Operations
  productCategories     String[] @default([])
  expectedMonthlyVolume String?
  hasPhysicalStore      Boolean  @default(false)
  storeLocation         String?

  // Payment Setup
  momoNetwork       String?
  momoNumber        String?
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?

  // Status
  status        VerificationStatus @default(PENDING)
  reviewerNotes String?
  reviewedBy    String?
  reviewedAt    DateTime?

  // Link to created vendor profile after approval
  vendorProfileId String?        @unique
  vendorProfile   VendorProfile? @relation(fields: [vendorProfileId], references: [id], onDelete: SetNull)

  // Documents
  documents VendorDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId])
  @@index([status])
  @@index([storeSlug])
}

model VendorDocument {
  id            String            @id @default(uuid())
  applicationId String
  application   VendorApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  type     DocumentType
  name     String
  url      String
  mimeType String?
  size     Int?

  status VerificationStatus @default(PENDING)
  notes  String?

  verificationSubmissions ShopVerificationDocument[]

  createdAt DateTime @default(now())

  @@index([applicationId])
}

// ==========================================
// VENDOR / TENANT PROFILE (THE SHOPS)
// ==========================================

model VendorProfile {
  id      String @id @default(uuid())
  ownerId String @unique
  owner   User   @relation("VendorOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  storeName          String
  slug               String                 @unique
  registrationNumber String?
  email              String?
  phone              String?
  website            String?
  logoUrl            String?
  bannerUrl          String?
  description        String?
  address            String?
  city               String?                @default("Kampala")
  country            String?                @default("Uganda")
  currency           String                 @default("UGX")
  timezone           String                 @default("Africa/Kampala")
  status             VendorStatus           @default(PENDING)
  verificationStatus ShopVerificationStatus @default(NOT_APPLIED)
  verifiedAt         DateTime?
  // Deprecated cache retained for compatibility with older consumers. The
  // verification service is the only writer and keeps it in sync.
  isVerified         Boolean                @default(false)

  momoMerchantCode  String?
  bankAccountName   String?
  bankAccountNumber String?
  bankName          String?

  fulfillmentMethods     FulfillmentMethod[] @default([DELIVERY])
  branchInventoryEnabled Boolean             @default(false)
  deliveryFee            Decimal             @default(3500.00) @db.Decimal(18, 2)
  deliveryEstimate       String?
  pickupLocation         String?
  pickupDirections       String?             @db.Text
  pickupInstructions     String?             @db.Text
  returnWindowDays       Int                 @default(7)
  returnPolicy           String?             @db.Text
  returnInstructions     String?             @db.Text
  returnAddress          String?             @db.Text
  acceptsExchanges       Boolean             @default(false)
  exchangePolicy         String?             @db.Text

  trialStartedAt   DateTime?
  trialEndsAt      DateTime?
  activatedAt      DateTime?
  suspendedAt      DateTime?
  bannedAt         DateTime?
  moderationReason String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  // Relations
  employees                User[]                        @relation("VendorEmployees")
  products                 Product[]
  subOrders                SubOrder[]
  ledgerEntries            FinancialLedger[]
  payouts                  VendorPayout[]
  payoutAccounts           VendorPayoutAccount[]
  paymentAccounts          VendorPaymentAccount[]
  paymentIntents           PaymentIntent[]
  subscriptions            VendorSubscription[]
  subscriptionLifecycleIntents SubscriptionLifecycleIntent[]
  subscriptionBillingIntents SubscriptionBillingIntent[]
  subscriptionPaidPeriods SubscriptionPaidPeriod[]
  trial                    VendorTrial?
  promotionCampaigns       PromotionCampaign[]
  promotionCredits         PromotionCreditLedger[]
  platformRevenueOrders    PlatformRevenueOrder[]
  platformPaymentIntents   PlatformPaymentIntent[]
  notifications            Notification[]
  auditLogs                AuditLog[]
  documents                Document[]
  vendorApplication        VendorApplication?
  featuredEntry            FeaturedShop?
  disputes                 Dispute[]
  riskFlags                RiskFlag[]
  shopReviews              ShopReview[]
  reviewReplies            ReviewReply[]                 @relation("VendorReviewReplies")
  marketplaceReports       MarketplaceReport[]
  verificationApplications ShopVerificationApplication[]
  branches                 ShopBranch[]
  branchInventories        BranchInventory[]
  inventoryMovements       InventoryMovement[]

  @@index([status])
  @@index([createdAt])
}

model ShopBranch {
  id                 String              @id @default(uuid())
  shopId             String
  shop               VendorProfile       @relation(fields: [shopId], references: [id], onDelete: Restrict)
  name               String
  slug               String
  branchType         ShopBranchType      @default(STORE)
  isPrimary          Boolean             @default(false)
  isActive           Boolean             @default(true)
  pickupEnabled      Boolean             @default(false)
  deliveryEnabled    Boolean             @default(false)
  addressLine        String?
  city               String?
  district           String?
  country            String?
  latitude           Decimal?            @db.Decimal(10, 7)
  longitude          Decimal?            @db.Decimal(10, 7)
  contactPhone       String?
  openingHours       Json?
  pickupInstructions String?             @db.Text
  deliveryAreas      String[]            @default([])
  deliveryFee        Decimal?            @db.Decimal(18, 2)
  deliveryEstimate   String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  subOrders          SubOrder[]
  inventories        BranchInventory[]
  inventoryMovements InventoryMovement[]

  @@unique([shopId, name])
  @@unique([shopId, slug])
  @@index([shopId, isActive])
}

model BranchInventory {
  id               String              @id @default(uuid())
  branchId         String
  branch           ShopBranch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  shopId           String
  shop             VendorProfile       @relation(fields: [shopId], references: [id], onDelete: Restrict)
  productId        String
  product          Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId        String?
  variant          ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: Restrict)
  onHandQuantity   Int                 @default(0)
  reservedQuantity Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  movements        InventoryMovement[]

  @@index([shopId, productId, variantId])
  @@index([branchId])
}

model InventoryMovement {
  id            String                @id @default(uuid())
  inventoryId   String
  inventory     BranchInventory       @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  branchId      String
  branch        ShopBranch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  shopId        String
  shop          VendorProfile         @relation(fields: [shopId], references: [id], onDelete: Restrict)
  productId     String
  variantId     String?
  movementType  InventoryMovementType
  quantity      Int
  referenceType String?
  referenceId   String?
  reason        String?
  createdById   String?
  requestId     String?
  createdAt     DateTime              @default(now())

  @@unique([shopId, requestId])
  @@index([inventoryId, createdAt])
  @@index([referenceType, referenceId])
}

model ShopVerificationApplication {
  id                 String                     @id @default(uuid())
  publicId           String                     @unique
  vendorId           String
  vendor             VendorProfile              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  submittedById      String
  submittedBy        User                       @relation("ShopVerificationSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  status             ShopVerificationStatus     @default(PENDING)
  snapshot           Json
  vendorResponse     String?                    @db.Text
  informationRequest String?                    @db.Text
  submittedAt        DateTime                   @default(now())
  reviewStartedAt    DateTime?
  assignedAdminId    String?
  assignedAdmin      User?                      @relation("ShopVerificationAssignedAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  assignedById       String?
  assignedBy         User?                      @relation("ShopVerificationAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedAt         DateTime?
  decisionById       String?
  decisionBy         User?                      @relation("ShopVerificationDecisionBy", fields: [decisionById], references: [id], onDelete: SetNull)
  decidedAt          DateTime?
  verifiedAt         DateTime?
  rejectionReason    String?                    @db.Text
  suspensionReason   String?                    @db.Text
  revocationReason   String?                    @db.Text
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  activities         ShopVerificationActivity[]
  notes              ShopVerificationNote[]
  documents          ShopVerificationDocument[]

  @@index([vendorId, status])
  @@index([status, submittedAt])
  @@index([assignedAdminId, status])
}

// References the exact existing documents reviewed for an application. The
// underlying files and document records remain authoritative and are not copied.
model ShopVerificationDocument {
  id               String                      @id @default(uuid())
  applicationId    String
  application      ShopVerificationApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documentId       String?
  document         Document?                   @relation(fields: [documentId], references: [id], onDelete: Restrict)
  vendorDocumentId String?
  vendorDocument   VendorDocument?             @relation(fields: [vendorDocumentId], references: [id], onDelete: Restrict)
  submittedAt      DateTime                    @default(now())

  @@unique([applicationId, documentId])
  @@unique([applicationId, vendorDocumentId])
  @@index([documentId])
  @@index([vendorDocumentId])
}

model ShopVerificationActivity {
  id            String                       @id @default(uuid())
  applicationId String
  application   ShopVerificationApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actorId       String?
  actor         User?                        @relation("ShopVerificationActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  type          ShopVerificationActivityType
  fromValue     String?
  toValue       String?
  metadata      Json?
  createdAt     DateTime                     @default(now())

  @@index([applicationId, createdAt])
}

model ShopVerificationNote {
  id            String                      @id @default(uuid())
  applicationId String
  application   ShopVerificationApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  adminId       String
  admin         User                        @relation("ShopVerificationNoteAuthor", fields: [adminId], references: [id], onDelete: Restrict)
  body          String                      @db.Text
  createdAt     DateTime                    @default(now())

  @@index([applicationId, createdAt])
}

// ==========================================
// COMMERCE E-COMMERCE ENGINE (CATALOG)
// ==========================================

model ProductCategory {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  taxonomyKey String? @unique
  description String?
  image       String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  parentId String?
  parent   ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("CategoryHierarchy")

  products    Product[] @relation("CategoryProducts")
  subProducts Product[] @relation("ProductSubCategory")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model Product {
  id            String           @id @default(uuid())
  vendorId      String
  vendor        VendorProfile    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      ProductCategory? @relation("CategoryProducts", fields: [categoryId], references: [id], onDelete: SetNull)
  subCategoryId String?
  subCategory   ProductCategory? @relation("ProductSubCategory", fields: [subCategoryId], references: [id], onDelete: SetNull)

  name        String
  slug        String  @unique
  brand       String?
  description String? @db.Text

  basePrice      Decimal  @db.Decimal(18, 2)
  compareAtPrice Decimal? @db.Decimal(18, 2)

  inventoryCount Int           @default(0)
  sku            String?
  status         ProductStatus @default(DRAFT)

  sizes  String[] @default([])
  colors String[] @default([])

  specs Json?

  tags String[] @default([])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  images             ProductImage[]
  variants           ProductVariant[]
  branchInventories  BranchInventory[]
  orderItems         OrderItem[]
  reviews            ProductReview[]
  wishlistItems      WishlistItem[]
  recentlyViewed     RecentlyViewed[]
  featuredEntry      FeaturedProduct?
  marketplaceReports MarketplaceReport[]
  promotionCampaigns PromotionCampaign[]

  @@unique([vendorId, slug])
  @@index([vendorId])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([status])
  @@index([categoryId, status, createdAt])
  @@index([subCategoryId, status, createdAt])
}

model PromotionCreditLedger {
  id         String                    @id @default(uuid())
  vendorId   String
  vendor     VendorProfile             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  type       PromotionCreditLedgerType
  amount     Decimal                   @db.Decimal(18, 2)
  grantKey   String?                   @unique
  releaseKey String?                   @unique
  reason     String
  expiresAt  DateTime?
  campaignId String?
  campaign   PromotionCampaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdAt  DateTime                  @default(now())

  @@index([vendorId, createdAt])
  @@index([vendorId, expiresAt])
}

model PromotionCampaign {
  id                String                      @id @default(uuid())
  vendorId          String
  vendor            VendorProfile               @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  targetType        PromotionCampaignTargetType
  productId         String?
  product           Product?                    @relation(fields: [productId], references: [id], onDelete: Cascade)
  dailyRate         Decimal                     @db.Decimal(18, 2)
  durationDays      Int
  subtotal          Decimal                     @db.Decimal(18, 2)
  creditApplied     Decimal                     @default(0) @db.Decimal(18, 2)
  amountDue         Decimal                     @db.Decimal(18, 2)
  currency          String                      @default("UGX") @db.VarChar(3)
  requestedStartAt  DateTime?
  startAt           DateTime?
  endAt             DateTime?
  status            PromotionCampaignStatus     @default(DRAFT)
  placement         AdvertisingPlacement
  fulfillmentStatus PromotionFulfillmentStatus  @default(PENDING_PAYMENT)
  fundingSource     String?
  idempotencyKey    String?
  revenueOrder      PlatformRevenueOrder?
  reservation       PromotionReservation?
  creditEntries     PromotionCreditLedger[]
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@unique([vendorId, idempotencyKey])
  @@index([vendorId, status])
  @@index([targetType, productId, status])
  @@index([startAt, endAt])
}

model AdvertisingPlacementInventory {
  id        String               @id @default(uuid())
  placement AdvertisingPlacement @unique
  capacity  Int
  isActive  Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

model PromotionReservation {
  id            String                     @id @default(uuid())
  campaignId    String                     @unique
  campaign      PromotionCampaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  placement     AdvertisingPlacement
  startAt       DateTime
  endAt         DateTime
  holdExpiresAt DateTime?
  status        PromotionReservationStatus
  confirmedAt   DateTime?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  @@index([placement, status, startAt, endAt])
  @@index([status, holdExpiresAt])
}

model PromotionQuote {
  id               String                      @id @default(uuid())
  vendorId         String
  targetType       PromotionCampaignTargetType
  productId        String?
  placement        AdvertisingPlacement
  durationDays     Int
  requestedStartAt DateTime?
  startAt          DateTime
  endAt            DateTime
  dailyRate        Decimal                     @db.Decimal(18, 2)
  subtotal         Decimal                     @db.Decimal(18, 2)
  creditApplied    Decimal                     @db.Decimal(18, 2)
  amountDue        Decimal                     @db.Decimal(18, 2)
  expiresAt        DateTime
  createdAt        DateTime                    @default(now())

  @@index([vendorId, expiresAt])
}

model PlatformRevenueOrder {
  id                String                           @id @default(uuid())
  vendorId          String
  vendor            VendorProfile                    @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  type              PlatformRevenueOrderType
  status            PlatformRevenueOrderStatus       @default(DRAFT)
  campaignId        String?                          @unique
  campaign          PromotionCampaign?               @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  subscriptionId    String?                          @unique
  subscription      VendorSubscription?              @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  subtotal          Decimal                          @db.Decimal(18, 2)
  creditApplied     Decimal                          @default(0) @db.Decimal(18, 2)
  amountDue         Decimal                          @db.Decimal(18, 2)
  currency          String                           @default("UGX") @db.VarChar(3)
  idempotencyKey    String?
  qualificationKind PlatformRevenueQualificationKind @default(NONE)
  qualificationId   String?
  paymentIntents    PlatformPaymentIntent[]
  subscriptionBillingIntent SubscriptionBillingIntent?
  createdAt         DateTime                         @default(now())
  updatedAt         DateTime                         @updatedAt

  @@unique([vendorId, idempotencyKey])
  @@unique([vendorId, qualificationId])
  @@index([vendorId, status])
}

model PlatformPaymentIntent {
  id                        String                      @id @default(uuid())
  platformRevenueOrderId    String
  platformRevenueOrder      PlatformRevenueOrder        @relation(fields: [platformRevenueOrderId], references: [id], onDelete: Restrict)
  vendorId                  String
  vendor                    VendorProfile               @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  provider                  PaymentProvider
  amount                    Decimal                     @db.Decimal(18, 2)
  currency                  String                      @default("UGX") @db.VarChar(3)
  status                    PlatformPaymentIntentStatus @default(PENDING)
  providerReference         String?                     @unique
  idempotencyKey            String?
  merchantDestinationMasked String?
  reconcileAttempts         Int                         @default(0)
  lastReconciledAt          DateTime?
  nextReconcileAt           DateTime?
  lastReconcileError        String?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  subscriptionPaidPeriod    SubscriptionPaidPeriod?

  @@unique([platformRevenueOrderId, idempotencyKey])
  @@index([vendorId, status])
}

model ProductImage {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url        String
  isFeatured Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([productId])
}

model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku            String  @unique
  name           String
  price          Decimal @db.Decimal(18, 2)
  inventoryCount Int     @default(0)
  options        Json
  optionKey      String
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems        OrderItem[]
  reviews           ProductReview[]
  branchInventories BranchInventory[]

  @@unique([productId, optionKey])
  @@index([productId])
}

model ProductReview {
  id               String          @id @default(uuid())
  productId        String
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Legacy reviews predate purchase proof and remain hidden. New writes are
  // required by ReviewService to provide an order item.
  orderItemId      String?         @unique
  orderItem        OrderItem?      @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  rating           Int             @default(5)
  title            String?         @db.VarChar(120)
  comment          String?         @db.Text
  imageUrls        String[]        @default([])
  status           ReviewStatus    @default(PUBLISHED)
  verifiedPurchase Boolean         @default(false)
  vendorReplies    ReviewReply[]
  reports          ReviewReport[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([productId])
  @@index([productId, status, createdAt])
  @@index([userId])
}

model ShopReview {
  id            String         @id @default(uuid())
  vendorId      String
  vendor        VendorProfile  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subOrderId    String         @unique
  subOrder      SubOrder       @relation(fields: [subOrderId], references: [id], onDelete: Restrict)
  rating        Int
  comment       String?        @db.Text
  status        ReviewStatus   @default(PUBLISHED)
  vendorReplies ReviewReply[]
  reports       ReviewReport[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([vendorId, status, createdAt])
  @@index([userId])
}

model ReviewReply {
  id              String         @id @default(uuid())
  productReviewId String?
  productReview   ProductReview? @relation(fields: [productReviewId], references: [id], onDelete: Cascade)
  shopReviewId    String?
  shopReview      ShopReview?    @relation(fields: [shopReviewId], references: [id], onDelete: Cascade)
  vendorId        String
  vendor          VendorProfile  @relation("VendorReviewReplies", fields: [vendorId], references: [id], onDelete: Cascade)
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  body            String         @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([productReviewId])
  @@unique([shopReviewId])
  @@index([vendorId])
}

model ReviewReport {
  id              String             @id @default(uuid())
  productReviewId String?
  productReview   ProductReview?     @relation(fields: [productReviewId], references: [id], onDelete: Cascade)
  shopReviewId    String?
  shopReview      ShopReview?        @relation(fields: [shopReviewId], references: [id], onDelete: Cascade)
  reporterId      String
  reporter        User               @relation("ReviewReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reason          String             @db.Text
  status          ReviewReportStatus @default(OPEN)
  resolvedById    String?
  resolvedBy      User?              @relation("ReviewReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolution      String?            @db.Text
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([productReviewId, reporterId])
  @@unique([shopReviewId, reporterId])
  @@index([status, createdAt])
}

model MarketplaceReport {
  id                  String                       @id @default(uuid())
  publicId            String                       @unique
  targetType          MarketplaceReportTargetType
  productId           String?
  product             Product?                     @relation(fields: [productId], references: [id], onDelete: SetNull)
  vendorId            String?
  vendor              VendorProfile?               @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  reporterId          String
  reporter            User                         @relation("MarketplaceReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  reason              MarketplaceReportReason
  description         String?                      @db.Text
  severity            MarketplaceReportSeverity    @default(UNASSESSED)
  status              MarketplaceReportStatus      @default(SUBMITTED)
  assignedAdminId     String?
  assignedAdmin       User?                        @relation("MarketplaceReportAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  assignedAt          DateTime?
  assignedById        String?
  assignedBy          User?                        @relation("MarketplaceReportAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  resolution          MarketplaceReportResolution?
  resolutionNote      String?                      @db.Text
  resolvedById        String?
  resolvedBy          User?                        @relation("MarketplaceReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt          DateTime?
  targetTitleSnapshot String
  targetSlugSnapshot  String?
  targetImageSnapshot String?
  vendorIdSnapshot    String?
  vendorNameSnapshot  String?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  activities          MarketplaceReportActivity[]
  notes               MarketplaceReportNote[]

  @@index([status, severity, createdAt])
  @@index([assignedAdminId, status, createdAt])
  @@index([targetType, productId])
  @@index([targetType, vendorId])
  @@index([reporterId, createdAt])
  @@index([resolvedAt])
}

model MarketplaceReportActivity {
  id        String                        @id @default(uuid())
  reportId  String
  report    MarketplaceReport             @relation(fields: [reportId], references: [id], onDelete: Restrict)
  actorId   String?
  actor     User?                         @relation("MarketplaceReportActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  type      MarketplaceReportActivityType
  fromValue String?
  toValue   String?
  metadata  Json?
  createdAt DateTime                      @default(now())

  @@index([reportId, createdAt])
}

model MarketplaceReportNote {
  id        String            @id @default(uuid())
  reportId  String
  report    MarketplaceReport @relation(fields: [reportId], references: [id], onDelete: Restrict)
  adminId   String
  admin     User              @relation("MarketplaceReportNoteAuthor", fields: [adminId], references: [id], onDelete: Restrict)
  body      String            @db.Text
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([reportId, createdAt])
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model RecentlyViewed {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now()) @updatedAt

  @@unique([userId, productId])
  @@index([userId, viewedAt])
}

// ==========================================
// THREE-TIER MULTI-VENDOR ORDER ENGINE
// ==========================================

model Order {
  id         String @id @default(uuid())
  customerId String
  customer   User   @relation("CustomerOrders", fields: [customerId], references: [id])

  orderNumber   String  @unique
  totalAmount   Decimal @db.Decimal(18, 2)
  currency      String  @db.VarChar(3)
  subTotal      Decimal @db.Decimal(18, 2)
  totalShipping Decimal @db.Decimal(18, 2)
  taxAmount     Decimal @default(0.00) @db.Decimal(18, 2)

  status         OrderStatus    @default(PENDING)
  paymentGateway PaymentGateway
  paymentStatus  PaymentStatus  @default(PENDING)

  gatewayReference    String?           @unique
  checkoutRequestId   String?
  checkoutRequestHash String?
  paymentAttempts     PaymentAttempt[]
  paymentIntents      PaymentIntent[]
  ledgerEntries       FinancialLedger[]
  shippingAddress     String
  shippingPhone       String
  shippingEmail       String
  notes               String?

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  subOrders  SubOrder[]
  orderItems OrderItem[]
  refunds    Refund[]
  disputes   Dispute[]
  riskFlags  RiskFlag[]

  @@unique([customerId, checkoutRequestId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model SubOrder {
  id       String        @id @default(uuid())
  orderId  String
  order    Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorId String
  vendor   VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  branchId String?
  branch   ShopBranch?   @relation(fields: [branchId], references: [id], onDelete: Restrict)

  subOrderNumber       String            @unique
  vendorSubTotal       Decimal           @db.Decimal(18, 2)
  vendorShipping       Decimal           @db.Decimal(18, 2)
  vendorTotal          Decimal           @db.Decimal(18, 2)
  platformCommission   Decimal           @db.Decimal(18, 2)
  commissionRate       Decimal?          @db.Decimal(5, 2)
  vendorNetEntitlement Decimal?          @db.Decimal(18, 2)
  paymentProcessingFee Decimal           @default(0.00) @db.Decimal(18, 2)
  ledgerEntries        FinancialLedger[]
  paymentIntents       PaymentIntent[]

  status                     SubOrderStatus              @default(PENDING)
  deliveryConfirmedAt        DateTime?
  deliveryConfirmedByUserId  String?
  deliveryConfirmationSource DeliveryConfirmationSource?
  notes                      String?
  fulfillmentMethod          FulfillmentMethod           @default(DELIVERY)
  fulfillmentStatus          FulfillmentStatus           @default(PENDING)
  fulfillmentSnapshot        Json?
  refundPolicySnapshot       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items          OrderItem[]
  returnRequests ReturnRequest[]
  refunds        Refund[]
  disputes       Dispute[]
  riskFlags      RiskFlag[]
  shopReview     ShopReview?

  @@index([orderId])
  @@index([vendorId])
  @@index([branchId])
  @@index([status])
}

// Destination for a direct customer payment.  The encrypted reference is never
// selected into client DTOs.  Legacy VendorPayoutAccount remains intact for
// historical payout/withdrawal data and is not used by checkout.
model VendorPaymentAccount {
  id                     String                     @id @default(uuid())
  vendorId               String
  vendor                 VendorProfile              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  provider               PaymentProvider
  merchantCode           String?
  merchantAccountId      String?
  merchantName           String?
  merchantPhoneEncrypted String?
  merchantPhoneHash      String?
  maskedMerchantPhone    String?
  status                 VendorPaymentAccountStatus @default(PENDING)
  isDefault              Boolean                    @default(false)
  verifiedAt             DateTime?
  rejectedAt             DateTime?
  suspendedAt            DateTime?
  verificationNote       String?
  createdById            String
  updatedById            String?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  paymentIntents         PaymentIntent[]

  @@unique([vendorId, provider, merchantPhoneHash])
  @@index([vendorId, status])
  @@index([vendorId, isDefault])
}

model PaymentIntent {
  id                     String                 @id @default(uuid())
  orderId                String
  order                  Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  subOrderId             String
  subOrder               SubOrder               @relation(fields: [subOrderId], references: [id], onDelete: Restrict)
  vendorId               String
  vendor                 VendorProfile          @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  vendorPaymentAccountId String
  vendorPaymentAccount   VendorPaymentAccount   @relation(fields: [vendorPaymentAccountId], references: [id], onDelete: Restrict)
  provider               PaymentProvider
  purpose                PaymentPurpose         @default(MARKETPLACE_PURCHASE)
  amount                 Decimal                @db.Decimal(18, 2)
  currency               String                 @default("UGX") @db.VarChar(3)
  status                 PaymentIntentStatus    @default(CREATED)
  providerReference      String?                @unique @db.VarChar(191)
  checkoutRequestId      String?
  idempotencyKey         String?
  failureCode            String?
  failureMessage         String?
  initiatedAt            DateTime?
  confirmedAt            DateTime?
  failedAt               DateTime?
  lastReconciledAt       DateTime?
  nextReconcileAt        DateTime?
  reconcileAttempts      Int                    @default(0)
  lastReconcileError     String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  providerEvents         PaymentProviderEvent[]

  @@unique([subOrderId, idempotencyKey])
  @@index([orderId, status])
  @@index([vendorId, status])
}

model PaymentProviderEvent {
  id                String               @id @default(uuid())
  paymentIntentId   String
  paymentIntent     PaymentIntent        @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)
  provider          PaymentProvider
  providerReference String?
  providerEventId   String?
  eventType         String
  normalizedStatus  PaymentIntentStatus?
  payloadHash       String
  processingResult  String
  processedAt       DateTime?
  failureReason     String?
  receivedAt        DateTime             @default(now())

  @@unique([provider, payloadHash])
  @@unique([provider, providerEventId])
  @@index([paymentIntentId, receivedAt])
}

model PaymentAttempt {
  id                  String               @id @default(uuid())
  orderId             String
  order               Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  gateway             PaymentGateway
  merchantReference   String               @unique @db.VarChar(50)
  initiationRequestId String?              @unique @db.VarChar(128)
  redirectUrl         String?              @db.Text
  providerTrackingId  String?              @unique @db.VarChar(191)
  amount              Decimal              @db.Decimal(18, 2)
  currency            String               @db.VarChar(3)
  status              PaymentAttemptStatus @default(CREATED)
  providerStatus      String?
  confirmationCode    String?
  paymentMethod       String?
  providerPayload     Json?
  initiatedAt         DateTime?
  verifiedAt          DateTime?
  completedAt         DateTime?
  orderCompletedAt    DateTime?
  reversedAt          DateTime?
  lastVerifiedAt      DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  ledgerEntries       FinancialLedger[]
  refunds             Refund[]

  @@index([orderId])
  @@index([status])
}

model OrderItem {
  id         String          @id @default(uuid())
  orderId    String
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subOrderId String
  subOrder   SubOrder        @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id])
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id])

  quantity               Int     @default(1)
  priceAtPurchase        Decimal @db.Decimal(18, 2)
  totalPrice             Decimal @db.Decimal(18, 2)
  productNameSnapshot    String?
  variantNameSnapshot    String?
  variantOptionsSnapshot Json?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  returnItems   ReturnItem[]
  refundItems   RefundItem[]
  productReview ProductReview?

  @@index([orderId])
  @@index([subOrderId])
  @@index([productId])
}

// ==========================================
// VENDOR EARNINGS & ESCROW LEDGERS
// ==========================================

model FinancialLedger {
  id                String                   @id @default(uuid())
  vendorId          String
  vendor            VendorProfile            @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  orderId           String?
  order             Order?                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  subOrderId        String?
  subOrder          SubOrder?                @relation(fields: [subOrderId], references: [id], onDelete: Restrict)
  paymentAttemptId  String?
  paymentAttempt    PaymentAttempt?          @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  vendorPayoutId    String?
  vendorPayout      VendorPayout?            @relation(fields: [vendorPayoutId], references: [id], onDelete: Restrict)
  type              LedgerTransactionType
  walletBucket      WalletBucket?
  amount            Decimal                  @db.Decimal(18, 2)
  currency          String?                  @db.VarChar(3)
  reference         String?
  description       String?
  createdAt         DateTime                 @default(now())
  payoutAllocations VendorPayoutAllocation[]
  refundId          String?
  refund            Refund?                  @relation(fields: [refundId], references: [id], onDelete: Restrict)

  @@unique([refundId, type])
  @@unique([vendorPayoutId, type])
  @@index([vendorId, currency, walletBucket])
  @@index([orderId])
  @@index([paymentAttemptId])
  @@index([vendorPayoutId])
}

model ReturnRequest {
  id                String       @id @default(uuid())
  subOrderId        String
  subOrder          SubOrder     @relation(fields: [subOrderId], references: [id], onDelete: Restrict)
  requestedByUserId String
  requestedBy       User         @relation("ReturnRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  status            ReturnStatus @default(REQUESTED)
  reason            String       @db.Text
  receivedAt        DateTime?
  completedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  items             ReturnItem[]
  refund            Refund?

  @@index([subOrderId, status])
  @@index([requestedByUserId])
}

model ReturnItem {
  id              String        @id @default(uuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItemId     String
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  quantity        Int
  restockedAt     DateTime?

  @@unique([returnRequestId, orderItemId])
  @@index([orderItemId])
}

model Refund {
  id                           String            @id @default(uuid())
  orderId                      String
  order                        Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  subOrderId                   String
  subOrder                     SubOrder          @relation(fields: [subOrderId], references: [id], onDelete: Restrict)
  paymentAttemptId             String?
  paymentAttempt               PaymentAttempt?   @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  returnRequestId              String?           @unique
  returnRequest                ReturnRequest?    @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)
  requestedByUserId            String
  requestedBy                  User              @relation("RefundRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  approvedByUserId             String?
  approvedBy                   User?             @relation("RefundApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  amount                       Decimal           @db.Decimal(18, 2)
  platformCommissionAdjustment Decimal           @default(0) @db.Decimal(18, 2)
  vendorLiabilityAdjustment    Decimal           @default(0) @db.Decimal(18, 2)
  shippingAmount               Decimal           @default(0) @db.Decimal(18, 2)
  gatewayFeeAdjustment         Decimal           @default(0) @db.Decimal(18, 2)
  currency                     String            @db.VarChar(3)
  reason                       String            @db.Text
  status                       RefundStatus      @default(REQUESTED)
  approvedAt                   DateTime?
  completedAt                  DateTime?
  createdAt                    DateTime          @default(now())
  updatedAt                    DateTime          @updatedAt
  ledgerEntries                FinancialLedger[]
  items                        RefundItem[]

  @@index([subOrderId, status])
  @@index([orderId])
  @@index([paymentAttemptId])
}

model Dispute {
  id               String        @id @default(uuid())
  customerId       String
  customer         User          @relation("DisputeCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  orderId          String
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  subOrderId       String
  subOrder         SubOrder      @relation(fields: [subOrderId], references: [id], onDelete: Restrict)
  vendorId         String
  vendor           VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  reason           String
  description      String        @db.Text
  status           DisputeStatus @default(OPEN)
  openedAt         DateTime      @default(now())
  resolvedAt       DateTime?
  resolvedByUserId String?
  resolvedBy       User?         @relation("DisputeResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  resolution       String?       @db.Text
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([customerId, createdAt])
  @@index([vendorId, status])
  @@index([subOrderId, status])
  @@index([orderId])
}

model RiskFlag {
  id               String           @id @default(uuid())
  scope            RiskFlagScope
  category         RiskFlagCategory
  source           RiskFlagSource   @default(ADMIN)
  severity         RiskSeverity
  status           RiskFlagStatus   @default(OPEN)
  reason           String           @db.Text
  customerId       String?
  customer         User?            @relation("RiskFlagCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  vendorId         String?
  vendor           VendorProfile?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  orderId          String?
  order            Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  subOrderId       String?
  subOrder         SubOrder?        @relation(fields: [subOrderId], references: [id], onDelete: SetNull)
  payoutId         String?
  payout           VendorPayout?    @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  createdByUserId  String
  createdBy        User             @relation("RiskFlagCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  resolvedByUserId String?
  resolvedBy       User?            @relation("RiskFlagResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  resolvedAt       DateTime?
  resolution       String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, severity])
  @@index([vendorId, status])
  @@index([subOrderId, status])
  @@index([orderId, status])
  @@index([payoutId, status])
}

model RefundItem {
  id          String    @id @default(uuid())
  refundId    String
  refund      Refund    @relation(fields: [refundId], references: [id], onDelete: Restrict)
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  quantity    Int
  grossAmount Decimal   @db.Decimal(18, 2)
  createdAt   DateTime  @default(now())

  @@unique([refundId, orderItemId])
  @@index([orderItemId])
}

model VendorPayout {
  id              String               @id @default(uuid())
  vendorId        String
  vendor          VendorProfile        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  payoutAccountId String?
  payoutAccount   VendorPayoutAccount? @relation(fields: [payoutAccountId], references: [id], onDelete: SetNull)

  amount              Decimal                @db.Decimal(18, 2)
  currency            String?                @db.VarChar(3)
  withdrawalRequestId String?
  requestHash         String?
  destinationType     PayoutDestinationType?
  maskedDestination   String?
  requestedByUserId   String?
  approvedByUserId    String?
  rejectedByUserId    String?
  cancelledByUserId   String?
  approvedAt          DateTime?
  rejectedAt          DateTime?
  cancelledAt         DateTime?
  readyAt             DateTime?
  merchantReference   String?                @unique
  gateway             PaymentGateway?
  reference           String?
  status              PayoutStatus           @default(PENDING)
  errorMessage        String?

  processedAt   DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  ledgerEntries FinancialLedger[]
  allocations   VendorPayoutAllocation[]
  riskFlags     RiskFlag[]

  @@unique([vendorId, withdrawalRequestId])
  @@index([vendorId])
  @@index([status])
}

// A payout destination is separate from a withdrawal. The encrypted reference
// is never selected into vendor-facing DTOs.
model VendorPayoutAccount {
  id                        String                      @id @default(uuid())
  vendorId                  String
  vendor                    VendorProfile               @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  type                      PayoutDestinationType
  provider                  VendorPayoutAccountProvider
  accountHolderName         String
  accountReferenceEncrypted String
  accountReferenceHash      String
  maskedReference           String
  status                    VendorPayoutAccountStatus   @default(PENDING)
  isDefault                 Boolean                     @default(false)
  verifiedAt                DateTime?
  verifiedById              String?
  createdById               String
  updatedById               String?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  payouts                   VendorPayout[]

  @@unique([vendorId, accountReferenceHash])
  @@index([vendorId, status])
  @@index([vendorId, isDefault])
}

model VendorPayoutAllocation {
  id              String                 @id @default(uuid())
  vendorPayoutId  String
  vendorPayout    VendorPayout           @relation(fields: [vendorPayoutId], references: [id], onDelete: Restrict)
  earningLedgerId String
  earningLedger   FinancialLedger        @relation(fields: [earningLedgerId], references: [id], onDelete: Restrict)
  vendorId        String
  currency        String                 @db.VarChar(3)
  allocatedAmount Decimal                @db.Decimal(18, 2)
  status          PayoutAllocationStatus @default(ACTIVE)
  releasedAt      DateTime?
  createdAt       DateTime               @default(now())

  @@unique([vendorPayoutId, earningLedgerId])
  @@index([earningLedgerId, status])
  @@index([vendorId, currency, status])
}

// ==========================================
// PLATFORM VENDOR SUBSCRIPTIONS
// ==========================================

model SubscriptionPlan {
  id           String       @id @default(uuid())
  name         String       @unique
  slug         String       @unique
  code         String       @unique
  description  String?
  price        Decimal      @db.Decimal(18, 2)
  currency     String       @default("UGX")
  billingCycle BillingCycle @default(MONTHLY)

  maxProducts       Int?
  commissionRate    Decimal @db.Decimal(5, 2)
  hasPremiumThemes  Boolean @default(false)
  hasAdvancedCharts Boolean @default(false)
  staffSeats        Int     @default(2)
  features          Json?
  sortOrder         Int     @default(0)
  isActive          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions VendorSubscription[]
  versions      SubscriptionPlanVersion[]
}

model SubscriptionPlanVersion {
  id                String                            @id @default(uuid())
  planId            String
  plan              SubscriptionPlan                  @relation(fields: [planId], references: [id], onDelete: Restrict)
  planCode          String
  version           Int
  policyVersion     String
  monthlyPriceUgx   Decimal                           @db.Decimal(18, 2)
  billingCycle      BillingCycle                      @default(MONTHLY)
  activeProductLimit Int?
  productSafetyCeiling Int?
  branchLimit       Int
  staffLimit        Int
  capabilities      String[]                          @default([])
  effectiveAt       DateTime
  publicationStatus SubscriptionPlanPublicationStatus @default(DRAFT)
  publishedAt       DateTime?
  retiredAt         DateTime?
  createdAt         DateTime                          @default(now())
  subscriptions     VendorSubscription[]
  billingIntents    SubscriptionBillingIntent[]
  paidPeriods       SubscriptionPaidPeriod[]

  @@unique([planCode, version])
  @@index([planId, publicationStatus, effectiveAt])
  @@index([policyVersion, publicationStatus])
}

model VendorSubscription {
  id       String           @id @default(uuid())
  vendorId String
  vendor   VendorProfile    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  planId   String
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])
  planVersionId String?
  planVersion   SubscriptionPlanVersion? @relation(fields: [planVersionId], references: [id], onDelete: Restrict)

  status             SubscriptionStatus    @default(TRIAL)
  startedAt          DateTime              @default(now())
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelledAt        DateTime?
  gracePeriodEndsAt  DateTime?
  revenueOrder       PlatformRevenueOrder?
  lifecycleIntents   SubscriptionLifecycleIntent[]
  billingIntents     SubscriptionBillingIntent[]
  paidPeriods        SubscriptionPaidPeriod[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@index([vendorId, status, currentPeriodEnd])
  @@index([planVersionId])
  @@index([status])
}

model SubscriptionLifecycleIntent {
  id                     String                            @id @default(uuid())
  vendorId               String
  vendor                 VendorProfile                     @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  subscriptionId         String
  subscription           VendorSubscription                @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  type                    SubscriptionLifecycleIntentType
  status                  SubscriptionLifecycleIntentStatus @default(PENDING)
  requestedPlanId         String?
  requestedPlanVersionId  String?
  effectiveAt             DateTime
  idempotencyKey          String                            @db.VarChar(191)
  requestedById           String
  requestedBy             User                              @relation("SubscriptionLifecycleIntentActor", fields: [requestedById], references: [id], onDelete: Restrict)
  cancelledAt             DateTime?
  appliedAt               DateTime?
  createdAt               DateTime                          @default(now())
  updatedAt               DateTime                          @updatedAt
  billingIntents          SubscriptionBillingIntent[]

  @@unique([vendorId, idempotencyKey])
  @@index([vendorId, status, effectiveAt])
  @@index([subscriptionId, status])
  @@index([requestedPlanId])
  @@index([requestedPlanVersionId])
}

model SubscriptionBillingIntent {
  id                       String                     @id @default(uuid())
  vendorId                 String
  vendor                   VendorProfile              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  requestedById            String
  requestedBy              User                       @relation("SubscriptionBillingIntentActor", fields: [requestedById], references: [id], onDelete: Restrict)
  subscriptionId           String
  subscription             VendorSubscription         @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  lifecycleIntentId        String?
  lifecycleIntent          SubscriptionLifecycleIntent? @relation(fields: [lifecycleIntentId], references: [id], onDelete: Restrict)
  planVersionId            String
  planVersion              SubscriptionPlanVersion    @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  revenueOrderId           String                     @unique
  revenueOrder             PlatformRevenueOrder       @relation(fields: [revenueOrderId], references: [id], onDelete: Restrict)
  purpose                  SubscriptionBillingPurpose
  amount                   Decimal                    @db.Decimal(18, 2)
  currency                 String                     @default("UGX") @db.VarChar(3)
  idempotencyKey           String                     @db.VarChar(191)
  merchantDestinationHash  String                     @db.VarChar(64)
  expiresAt                DateTime
  activatedAt              DateTime?
  reviewReason             String?                    @db.Text
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  paidPeriod               SubscriptionPaidPeriod?

  @@unique([vendorId, idempotencyKey])
  @@index([vendorId, purpose, expiresAt])
  @@index([subscriptionId, createdAt])
  @@index([lifecycleIntentId, createdAt])
  @@index([planVersionId])
}

model SubscriptionPaidPeriod {
  id                String                         @id @default(uuid())
  vendorId          String
  vendor            VendorProfile                  @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  subscriptionId    String
  subscription      VendorSubscription              @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  billingIntentId   String                         @unique
  billingIntent     SubscriptionBillingIntent       @relation(fields: [billingIntentId], references: [id], onDelete: Restrict)
  paymentIntentId   String                         @unique
  paymentIntent     PlatformPaymentIntent           @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  planVersionId     String
  planVersion       SubscriptionPlanVersion         @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  status            SubscriptionPaidPeriodStatus
  periodStart       DateTime
  periodEnd         DateTime
  amount            Decimal                        @db.Decimal(18, 2)
  currency          String                         @db.VarChar(3)
  activatedAt       DateTime?
  endedAt           DateTime?
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt

  @@unique([subscriptionId, periodStart])
  @@index([vendorId, status, periodStart])
  @@index([subscriptionId, periodEnd])
}

model VendorTrial {
  id                       String            @id @default(uuid())
  vendorId                 String            @unique
  vendor                   VendorProfile     @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  status                   VendorTrialStatus
  eligible                 Boolean
  eligibilityDeterminedAt  DateTime?
  activatedAt              DateTime?
  expiresAt                DateTime?
  policyVersion            String
  activationKey            String?           @unique
  administrativeReason     String?           @db.Text
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  extensions               VendorTrialExtension[]

  @@index([status, expiresAt])
}

model VendorTrialExtension {
  id                String      @id @default(uuid())
  trialId           String
  trial             VendorTrial @relation(fields: [trialId], references: [id], onDelete: Restrict)
  previousExpiresAt DateTime
  newExpiresAt      DateTime
  reason            String      @db.Text
  extendedById      String
  extendedBy        User        @relation("VendorTrialExtensionActor", fields: [extendedById], references: [id], onDelete: Restrict)
  createdAt         DateTime    @default(now())

  @@index([trialId, createdAt])
  @@index([extendedById])
}

// ==========================================
// SYSTEM ENGINE, AUDIT LOGS, INTEGRATIONS
// ==========================================

model Notification {
  id             String         @id @default(uuid())
  idempotencyKey String?        @unique @db.VarChar(191)
  vendorId       String?
  vendor         VendorProfile? @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  type       NotificationType    @default(INFO)
  eventType  String?             @db.VarChar(80)
  title      String
  message    String
  actionPath String?
  readAt     DateTime?
  deletedAt  DateTime?
  createdAt  DateTime            @default(now())
  pushOutbox PushDeliveryOutbox?

  @@index([vendorId])
  @@index([userId])
  @@index([readAt])
  @@index([userId, deletedAt, createdAt])
}

enum BrowserPushSubscriptionStatus {
  ACTIVE
  REVOKED
}

enum PushDeliveryKind {
  TRANSACTIONAL
  ANNOUNCEMENT
  MARKETING
  TEST
}

enum PushDeliveryStatus {
  PENDING
  PROCESSING
  RETRYING
  DELIVERED
  SKIPPED
  FAILED
}

model BrowserPushSubscription {
  id                  String                        @id @default(uuid())
  userId              String
  user                User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpointHash        String                        @unique @db.VarChar(64)
  endpointEncrypted   String
  p256dhEncrypted     String
  authEncrypted       String
  userAgent           String?                       @db.VarChar(512)
  deviceName          String?                       @db.VarChar(120)
  status              BrowserPushSubscriptionStatus @default(ACTIVE)
  registrationVersion Int                           @default(1)
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  failureCount        Int                           @default(0)
  revokedAt           DateTime?
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  @@index([userId, status])
  @@index([status, updatedAt])
}

model PushDeliveryOutbox {
  id                        String                         @id @default(uuid())
  idempotencyKey            String                         @unique @db.VarChar(191)
  userId                    String
  user                      User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationId            String?                        @unique
  notification              Notification?                  @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  announcementId            String?
  announcement              Announcement?                  @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  marketingCampaignId       String?
  marketingCampaign         MarketingNotificationCampaign? @relation(fields: [marketingCampaignId], references: [id], onDelete: Cascade)
  // Test deliveries are intentionally bound to one verified browser. Normal
  // business deliveries continue to fan out to the account's active devices.
  targetSubscriptionId      String?
  targetSubscriptionVersion Int?
  kind                      PushDeliveryKind
  title                     String                         @db.VarChar(160)
  message                   String                         @db.VarChar(1000)
  actionPath                String?                        @db.VarChar(500)
  status                    PushDeliveryStatus             @default(PENDING)
  attempts                  Int                            @default(0)
  nextAttemptAt             DateTime                       @default(now())
  lockedAt                  DateTime?
  lockToken                 String?                        @db.VarChar(80)
  deliveredAt               DateTime?
  lastFailureAt             DateTime?
  failureCode               String?                        @db.VarChar(80)
  createdAt                 DateTime                       @default(now())
  updatedAt                 DateTime                       @updatedAt
  nativeDeliveries          NativePushDelivery[]

  @@unique([announcementId, userId])
  @@unique([marketingCampaignId, targetSubscriptionId])
  @@index([status, nextAttemptAt])
  @@index([userId, status])
  @@index([targetSubscriptionId, status])
}

model NativePushDelivery {
  id            String             @id @default(uuid())
  outboxId      String
  outbox        PushDeliveryOutbox @relation(fields: [outboxId], references: [id], onDelete: Cascade)
  deviceId      String
  device        UserDevice         @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  status        PushDeliveryStatus @default(PENDING)
  attempts      Int                @default(0)
  deliveredAt   DateTime?
  lastFailureAt DateTime?
  failureCode   String?            @db.VarChar(120)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([outboxId, deviceId])
  @@index([deviceId])
  @@index([status, updatedAt])
}

model Announcement {
  id            String                    @id @default(uuid())
  title         String                    @db.VarChar(160)
  message       String                    @db.VarChar(2000)
  category      AnnouncementCategory      @default(GENERAL)
  priority      AnnouncementPriority      @default(NORMAL)
  audience      AnnouncementAudience
  presentation  AnnouncementPresentation  @default(NOTIFICATION)
  contentClass  AnnouncementContentClass  @default(ESSENTIAL)
  pushEnabled   Boolean                   @default(false)
  destination   String?                   @db.VarChar(500)
  status        AnnouncementStatus        @default(DRAFT)
  scheduledAt   DateTime?
  publishedAt   DateTime?
  expiresAt     DateTime?
  createdById   String
  createdBy     User                      @relation("AnnouncementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  publishedById String?
  publishedBy   User?                     @relation("AnnouncementPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  userStates    AnnouncementUserState[]
  pushDispatch  AnnouncementPushDispatch?
  pushOutbox    PushDeliveryOutbox[]

  @@index([status, scheduledAt])
  @@index([status, publishedAt])
  @@index([audience, status, publishedAt])
  @@index([presentation, status, expiresAt])
}

model AnnouncementPushDispatch {
  id                  String                         @id @default(uuid())
  announcementId      String                         @unique
  announcement        Announcement                   @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  status              AnnouncementPushDispatchStatus @default(PENDING)
  cursorUserId        String?
  processedRecipients Int                            @default(0)
  queuedRecipients    Int                            @default(0)
  lockedAt            DateTime?
  lockToken           String?                        @db.VarChar(80)
  createdAt           DateTime                       @default(now())
  startedAt           DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  updatedAt           DateTime                       @updatedAt

  @@index([status, updatedAt])
}

model AnnouncementUserState {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime?
  dismissedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([announcementId, userId])
  @@index([userId, readAt])
  @@index([userId, dismissedAt])
}

model MarketingNotificationCampaign {
  id                   String                           @id @default(uuid())
  name                 String                           @db.VarChar(160)
  title                String                           @db.VarChar(160)
  message              String                           @db.VarChar(2000)
  category             MarketingNotificationCategory
  audience             MarketingNotificationAudience
  destinationType      MarketingDestinationType
  destinationReference String?                          @db.VarChar(191)
  destinationPath      String                           @db.VarChar(500)
  imageUrl             String?                          @db.VarChar(1000)
  pushEnabled          Boolean                          @default(false)
  status               AnnouncementStatus               @default(DRAFT)
  scheduledAt          DateTime?
  publishedAt          DateTime?
  expiresAt            DateTime?
  createdById          String
  createdBy            User                             @relation("MarketingCampaignCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  publishedById        String?
  publishedBy          User?                            @relation("MarketingCampaignPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  createdAt            DateTime                         @default(now())
  updatedAt            DateTime                         @updatedAt
  userStates           MarketingNotificationUserState[]
  pushDispatch         MarketingPushDispatch?
  pushOutbox           PushDeliveryOutbox[]

  @@index([status, scheduledAt])
  @@index([status, publishedAt, expiresAt])
  @@index([audience, status, publishedAt])
  @@index([destinationType, destinationReference])
}

model MarketingPushDispatch {
  id                  String                         @id @default(uuid())
  campaignId          String                         @unique
  campaign            MarketingNotificationCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  status              AnnouncementPushDispatchStatus @default(PENDING)
  cursorUserId        String?
  processedRecipients Int                            @default(0)
  eligibleRecipients  Int                            @default(0)
  queuedJobs          Int                            @default(0)
  lockedAt            DateTime?
  lockToken           String?                        @db.VarChar(80)
  createdAt           DateTime                       @default(now())
  startedAt           DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  updatedAt           DateTime                       @updatedAt

  @@index([status, updatedAt])
}

model MarketingNotificationUserState {
  id          String                        @id @default(uuid())
  campaignId  String
  campaign    MarketingNotificationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId      String
  user        User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveredAt DateTime                      @default(now())
  readAt      DateTime?
  dismissedAt DateTime?
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt

  @@unique([campaignId, userId])
  @@index([userId, deliveredAt])
  @@index([userId, readAt])
  @@index([userId, dismissedAt])
}

model Document {
  id       String         @id @default(uuid())
  vendorId String?
  vendor   VendorProfile? @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  type      DocumentType @default(OTHER)
  name      String
  url       String
  mimeType  String?
  size      Int?
  createdAt DateTime     @default(now())

  verificationSubmissions ShopVerificationDocument[]

  @@index([vendorId])
}

model AuditLog {
  id       String         @id @default(uuid())
  vendorId String?
  vendor   VendorProfile? @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  action    String
  entity    String
  entityId  String?
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([vendorId])
  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

model PesapalIpnRegistry {
  id          String   @id @default(uuid())
  ipnId       String   @unique
  url         String
  environment String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ipnId])
}

model PaymentGatewayWebhookLog {
  id           String               @id @default(uuid())
  gateway      PaymentGateway
  trackingId   String
  reference    String
  eventType    String?
  payload      Json
  status       WebhookProcessStatus @default(UNPROCESSED)
  errorMessage String?
  createdAt    DateTime             @default(now())

  @@index([trackingId])
  @@index([reference])
  @@index([status])
}

model ReconciliationFinding {
  id               String                      @id @default(uuid())
  type             String
  domain           ReconciliationDomain
  severity         ReconciliationSeverity
  entityType       String
  entityId         String
  vendorId         String?
  orderId          String?
  subOrderId       String?
  paymentAttemptId String?
  vendorPayoutId   String?
  refundId         String?
  status           ReconciliationFindingStatus @default(OPEN)
  detectedAt       DateTime                    @default(now())
  resolvedAt       DateTime?
  resolution       String?
  metadata         Json?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  @@unique([type, entityType, entityId])
  @@index([status, severity])
  @@index([domain, status])
  @@index([vendorId, status])
}

// A batch is the administrative review boundary for test ownership. DRAFT
// batches cannot be previewed or cleaned until a different super administrator
// (or a controlled seed process outside production) verifies them.
model TestDataBatch {
  id          String               @id @default(uuid())
  name        String
  description String?              @db.Text
  environment TestDataEnvironment
  status      TestDataBatchStatus  @default(DRAFT)
  createdBy   String
  reviewedBy  String?
  reviewNote  String?              @db.Text
  verifiedAt  DateTime?
  revokedAt   DateTime?
  cleanedAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  records     TestDataRegistry[]
  cleanupJobs TestDataCleanupJob[]

  @@index([status, environment])
  @@index([createdAt])
}

model TestDataRegistry {
  id                   String                       @id @default(uuid())
  batchId              String
  batch                TestDataBatch                @relation(fields: [batchId], references: [id], onDelete: Restrict)
  entityType           String
  entityId             String
  environment          TestDataEnvironment
  financialDisposition TestDataFinancialDisposition @default(NOT_FINANCIAL)
  externalProvider     String?
  externalId           String?
  externalAccountId    String?
  externalUserId       String?
  ownershipMetadata    Json?
  createdBy            String
  createdAt            DateTime                     @default(now())

  @@unique([environment, entityType, entityId])
  @@index([batchId, entityType])
  @@index([entityType, entityId])
}

// The complete server-generated plan is retained for stale-plan detection,
// idempotent retries, auditability, and explicit multi-step recovery semantics.
model TestDataCleanupJob {
  id            String                        @id @default(uuid())
  batchId       String?
  batch         TestDataBatch?                @relation(fields: [batchId], references: [id], onDelete: Restrict)
  scope         TestDataCleanupScope
  scopeId       String?
  environment   TestDataEnvironment
  status        TestDataCleanupStatus         @default(PLANNED)
  plan          Json
  planHash      String
  confirmation  String?
  requestedBy   String
  startedAt     DateTime?
  completedAt   DateTime?
  failedAt      DateTime?
  expiresAt     DateTime
  error         String?                       @db.Text
  result        Json?
  createdAt     DateTime                      @default(now())
  updatedAt     DateTime                      @updatedAt
  storageTasks  StorageCleanupTask[]
  identityTasks ExternalIdentityCleanupTask[]

  @@index([status, expiresAt])
  @@index([scope, scopeId, status])
  @@index([requestedBy, createdAt])
}

model StorageCleanupTask {
  id             String               @id @default(uuid())
  cleanupJobId   String
  cleanupJob     TestDataCleanupJob   @relation(fields: [cleanupJobId], references: [id], onDelete: Restrict)
  bucket         String
  objectPath     String
  status         StorageCleanupStatus @default(PENDING)
  attempts       Int                  @default(0)
  claimedAt      DateTime?
  leaseExpiresAt DateTime?
  nextAttemptAt  DateTime             @default(now())
  lastError      String?              @db.Text
  completedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([cleanupJobId, bucket, objectPath])
  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
}

model ExternalIdentityCleanupTask {
  id                String               @id @default(uuid())
  cleanupJobId      String
  cleanupJob        TestDataCleanupJob   @relation(fields: [cleanupJobId], references: [id], onDelete: Restrict)
  provider          String
  externalId        String
  expectedUserId    String?
  expectedAccountId String?
  status            StorageCleanupStatus @default(PENDING)
  attempts          Int                  @default(0)
  claimedAt         DateTime?
  leaseExpiresAt    DateTime?
  nextAttemptAt     DateTime             @default(now())
  lastError         String?              @db.Text
  completedAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([cleanupJobId, provider, externalId])
  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS & CONSTANTS
// ==========================================

enum PlatformRole {
  SUPER_ADMIN
  ADMIN
  SUPPORT
  BILLING
  VENDOR
  CUSTOMER
}

enum VendorStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum VendorUserRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
  ACCOUNTANT
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  ARCHIVED
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum SubOrderStatus {
  PENDING
  PROCESSING
  READY_FOR_PICKUP
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum FulfillmentMethod {
  DELIVERY
  PICKUP
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  COMPLETED
  FAILED
  REVERSED
}

enum PayoutStatus {
  PENDING
  REQUESTED
  APPROVED
  READY_FOR_DISBURSEMENT
  REJECTED
  CANCELLED
  PROCESSING
  COMPLETED
  FAILED
}

enum PayoutDestinationType {
  MOBILE_MONEY
  BANK_ACCOUNT
}

enum DeliveryConfirmationSource {
  CUSTOMER
  PLATFORM_ADMIN
  LOGISTICS
}

enum PayoutAllocationStatus {
  ACTIVE
  RELEASED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  READY_FOR_PROVIDER_REFUND
  COMPLETED
  FAILED
  REJECTED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  COMPLETED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_CUSTOMER
  RESOLVED_VENDOR
  REJECTED
  CANCELLED
}

enum RiskFlagScope {
  CUSTOMER
  VENDOR
  ORDER
  SUBORDER
  PAYMENT
  PAYOUT
}

enum RiskFlagCategory {
  SUSPICIOUS_PAYMENT
  ACCOUNT_TAKEOVER_SUSPECTED
  UNUSUAL_ORDER_ACTIVITY
  REFUND_ABUSE
  VENDOR_FULFILLMENT_RISK
  MANUAL_REVIEW
}

enum RiskFlagSource {
  SYSTEM
  ADMIN
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskFlagStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ReconciliationDomain {
  PAYMENT
  ORDER
  VENDOR_EARNINGS
  PAYOUT
  REFUND
  REVERSAL
  RISK
}

enum ReconciliationSeverity {
  INFO
  WARNING
  HIGH
  CRITICAL
}

enum ReconciliationFindingStatus {
  OPEN
  RESOLVED
  IGNORED
}

enum PaymentAttemptStatus {
  CREATED
  SUBMISSION_UNKNOWN
  INITIATED
  COMPLETED
  FAILED
  REVERSED
}

enum LedgerTransactionType {
  SALE_REVENUE
  PLATFORM_COMMISSION
  SUBSCRIPTION_PAYMENT
  VENDOR_PAYOUT
  REFUND_DEDUCTION
  SALE_PENDING
  SALE_RELEASE
  SALE_AVAILABLE
  PAYOUT_RESERVE
  PAYOUT_RESERVED
  PAYOUT_COMPLETE
  PAYOUT_RELEASE
  PAYOUT_AVAILABLE
  REFUND_ADJUSTMENT
  REVERSAL_ADJUSTMENT
  MANUAL_ADJUSTMENT
  SALE_REVERSAL_PENDING
  SALE_REVERSAL_AVAILABLE
  PLATFORM_COMMISSION_REVERSAL
}

enum WalletBucket {
  PENDING
  AVAILABLE
  RESERVED
  PAID_OUT
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PaymentGateway {
  PESAPAL
  STRIPE
  MTN_MOMO
  AIRTEL_MONEY
  CASH_ON_DELIVERY
}

enum WebhookProcessStatus {
  UNPROCESSED
  PROCESSED
  FAILED
  SKIPPED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  ORDER_PLACED
  LOW_STOCK
  PAYMENT_RECEIVED
  SYSTEM
}

enum DocumentType {
  NATIONAL_ID
  PASSPORT
  BUSINESS_REGISTRATION
  TAX_CERTIFICATE
  TRADING_LICENSE
  OTHER
}

enum VerificationStatus {
  PENDING
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  DISABLED
}
enum PromotionPlacement {
  HOMEPAGE
  PRODUCTS
  SHOPS
}
enum PromotionCtaType {
  PRODUCT
  SHOP
  CATEGORY
  INTERNAL_PATH
  EXTERNAL_URL
}

enum ReviewStatus {
  PUBLISHED
  PENDING
  HIDDEN
  REMOVED
}

enum ReviewReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// ==========================================
// NEXT-AUTH REQUIRED MODELS
// ==========================================

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// USER & CORE AUTHENTICATION SECURITY
// ==========================================

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  phone        String?
  passwordHash String?
  avatarUrl    String?
  status       UserStatus    @default(PENDING)
  platformRole PlatformRole?

  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  vendorId      String?
  vendorRole    VendorUserRole?
  vendorProfile VendorProfile?  @relation("VendorEmployees", fields: [vendorId], references: [id], onDelete: SetNull)
  ownedVendor   VendorProfile?  @relation("VendorOwner")

  settings UserSettings?

  accounts Account[]
  sessions Session[]

  vendorApplications VendorApplication[]

  wishlistItems     WishlistItem[]
  recentlyViewed    RecentlyViewed[]
  customerOrders    Order[]          @relation("CustomerOrders")
  reviewsWritten    ProductReview[]
  shopReviewsWritten ShopReview[]
  reviewReplies      ReviewReply[]
  reviewReports      ReviewReport[] @relation("ReviewReporter")
  reviewReportsResolved ReviewReport[] @relation("ReviewReportResolver")
  auditLogs         AuditLog[]
  notifications     Notification[]
  returnRequests    ReturnRequest[]  @relation("ReturnRequester")
  refundsRequested  Refund[]         @relation("RefundRequester")
  refundsApproved   Refund[]         @relation("RefundApprover")
  disputesOpened    Dispute[]        @relation("DisputeCustomer")
  disputesResolved  Dispute[]        @relation("DisputeResolver")
  riskFlagsCreated  RiskFlag[]       @relation("RiskFlagCreator")
  riskFlagsResolved RiskFlag[]       @relation("RiskFlagResolver")
  customerRiskFlags RiskFlag[]       @relation("RiskFlagCustomer")

  @@index([status])
  @@index([vendorId])
  @@index([platformRole])
}

model Promotion {
  id String @id @default(uuid())
  title String
  subtitle String?
  desktopImageUrl String
  mobileImageUrl String?
  status PromotionStatus @default(DRAFT)
  priority Int @default(100)
  startsAt DateTime?
  endsAt DateTime?
  primaryCtaLabel String?
  primaryCtaType PromotionCtaType?
  primaryCtaValue String?
  secondaryCtaLabel String?
  secondaryCtaType PromotionCtaType?
  secondaryCtaValue String?
  placements PromotionPlacement[]
  createdByUserId String
  updatedByUserId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, priority])
}

model FeaturedProduct {
  id String @id @default(uuid())
  productId String @unique
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  priority Int @default(100)
  isActive Boolean @default(true)
  startsAt DateTime?
  endsAt DateTime?
  createdByUserId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([isActive, priority])
}

model FeaturedShop {
  id String @id @default(uuid())
  vendorId String @unique
  vendor VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  priority Int @default(100)
  isActive Boolean @default(true)
  startsAt DateTime?
  endsAt DateTime?
  createdByUserId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([isActive, priority])
}

// ==========================================
// USER SETTINGS & PREFERENCES
// ==========================================

model UserSettings {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName    String?
  phoneNumber String?
  avatarUrl   String?

  currency         String  @default("UGX")
  primaryLanguage  String  @default("en")
  deliveryDistrict String?

  momoNetwork String?
  momoNumber  String?

  orderAlertsEmail    Boolean @default(true)
  orderAlertsPush     Boolean @default(true)
  securityAlertsSMS   Boolean @default(true)
  marketingNewsletter Boolean @default(false)

  twoFactorEnabled       Boolean @default(false)
  buyerProtectionEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ==========================================
// VENDOR KYC / ONBOARDING
// ==========================================

model VendorApplication {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Business Info
  storeName          String
  storeSlug          String  @unique
  businessType       String
  registrationNumber String?
  taxId              String?

  // Contact
  businessEmail String
  businessPhone String
  website       String?

  // Address
  streetAddress String
  city          String  @default("Kampala")
  district      String?
  country       String  @default("Uganda")
  postalCode    String?

  // Operations
  productCategories     String[] @default([])
  expectedMonthlyVolume String?
  hasPhysicalStore      Boolean  @default(false)
  storeLocation         String?

  // Payment Setup
  momoNetwork       String?
  momoNumber        String?
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?

  // Status
  status        VerificationStatus @default(PENDING)
  reviewerNotes String?
  reviewedBy    String?
  reviewedAt    DateTime?

  // Link to created vendor profile after approval
  vendorProfileId String?        @unique
  vendorProfile   VendorProfile? @relation(fields: [vendorProfileId], references: [id], onDelete: SetNull)

  // Documents
  documents VendorDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId])
  @@index([status])
  @@index([storeSlug])
}

model VendorDocument {
  id            String            @id @default(uuid())
  applicationId String
  application   VendorApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  type     DocumentType
  name     String
  url      String
  mimeType String?
  size     Int?

  status VerificationStatus @default(PENDING)
  notes  String?

  createdAt DateTime @default(now())

  @@index([applicationId])
}

// ==========================================
// VENDOR / TENANT PROFILE (THE SHOPS)
// ==========================================

model VendorProfile {
  id      String @id @default(uuid())
  ownerId String @unique
  owner   User   @relation("VendorOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  storeName          String
  slug               String       @unique
  registrationNumber String?
  email              String?
  phone              String?
  website            String?
  logoUrl            String?
  bannerUrl          String?
  description        String?
  address            String?
  city               String?      @default("Kampala")
  country            String?      @default("Uganda")
  currency           String       @default("UGX")
  timezone           String       @default("Africa/Kampala")
  status             VendorStatus @default(PENDING)
  isVerified         Boolean      @default(false)

  momoMerchantCode  String?
  bankAccountName   String?
  bankAccountNumber String?
  bankName          String?

  fulfillmentMethods  FulfillmentMethod[] @default([DELIVERY])
  deliveryFee         Decimal              @default(3500.00) @db.Decimal(18, 2)
  deliveryEstimate    String?
  pickupLocation      String?
  pickupDirections    String?              @db.Text
  pickupInstructions  String?              @db.Text
  returnWindowDays    Int                  @default(7)
  returnPolicy        String?              @db.Text
  returnInstructions  String?              @db.Text
  returnAddress       String?              @db.Text
  acceptsExchanges    Boolean              @default(false)
  exchangePolicy      String?              @db.Text

  trialEndsAt DateTime?
  activatedAt DateTime?
  suspendedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Relations
  employees         User[]               @relation("VendorEmployees")
  products          Product[]
  subOrders         SubOrder[]
  ledgerEntries     FinancialLedger[]
  payouts           VendorPayout[]
  subscriptions     VendorSubscription[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  documents         Document[]
  vendorApplication VendorApplication?
  featuredEntry FeaturedShop?
  disputes          Dispute[]
  riskFlags         RiskFlag[]
  shopReviews       ShopReview[]
  reviewReplies     ReviewReply[] @relation("VendorReviewReplies")

  @@index([status])
  @@index([createdAt])
}

// ==========================================
// COMMERCE E-COMMERCE ENGINE (CATALOG)
// ==========================================

model ProductCategory {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  image       String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  parentId String?
  parent   ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("CategoryHierarchy")

  products    Product[] @relation("CategoryProducts")
  subProducts Product[] @relation("ProductSubCategory")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model Product {
  id            String           @id @default(uuid())
  vendorId      String
  vendor        VendorProfile    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      ProductCategory? @relation("CategoryProducts", fields: [categoryId], references: [id], onDelete: SetNull)
  subCategoryId String?
  subCategory   ProductCategory? @relation("ProductSubCategory", fields: [subCategoryId], references: [id], onDelete: SetNull)

  name        String
  slug        String  @unique
  brand       String?
  description String? @db.Text

  basePrice      Decimal  @db.Decimal(18, 2)
  compareAtPrice Decimal? @db.Decimal(18, 2)

  inventoryCount Int           @default(0)
  sku            String?
  status         ProductStatus @default(DRAFT)

  sizes  String[] @default([])
  colors String[] @default([])

  specs Json?

  tags String[] @default([])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  images         ProductImage[]
  variants       ProductVariant[]
  orderItems     OrderItem[]
  reviews        ProductReview[]
  wishlistItems  WishlistItem[]
  recentlyViewed RecentlyViewed[]
  featuredEntry FeaturedProduct?

  @@unique([vendorId, slug])
  @@index([vendorId])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([status])
  @@index([categoryId, status, createdAt])
  @@index([subCategoryId, status, createdAt])
}

model ProductImage {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url        String
  isFeatured Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([productId])
}

model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku            String  @unique
  name           String
  price          Decimal @db.Decimal(18, 2)
  inventoryCount Int     @default(0)
  options        Json
  optionKey      String
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]
  reviews    ProductReview[]

  @@index([productId])
  @@unique([productId, optionKey])
}

model ProductReview {
  id               String    @id @default(uuid())
  productId        String
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Legacy reviews predate purchase proof and remain hidden. New writes are
  // required by ReviewService to provide an order item.
  orderItemId      String?   @unique
  orderItem        OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  rating           Int       @default(5)
  title            String?   @db.VarChar(120)
  comment          String?   @db.Text
  imageUrls        String[]  @default([])
  status           ReviewStatus @default(PUBLISHED)
  verifiedPurchase Boolean   @default(false)
  vendorReplies    ReviewReply[]
  reports          ReviewReport[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([productId])
  @@index([productId, status, createdAt])
  @@index([userId])
}

model ShopReview {
  id          String        @id @default(uuid())
  vendorId    String
  vendor      VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subOrderId  String        @unique
  subOrder    SubOrder      @relation(fields: [subOrderId], references: [id], onDelete: Restrict)
  rating      Int
  comment     String?       @db.Text
  status      ReviewStatus  @default(PUBLISHED)
  vendorReplies ReviewReply[]
  reports     ReviewReport[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([vendorId, status, createdAt])
  @@index([userId])
}

model ReviewReply {
  id              String         @id @default(uuid())
  productReviewId String?
  productReview   ProductReview? @relation(fields: [productReviewId], references: [id], onDelete: Cascade)
  shopReviewId    String?
  shopReview      ShopReview?    @relation(fields: [shopReviewId], references: [id], onDelete: Cascade)
  vendorId        String
  vendor          VendorProfile  @relation("VendorReviewReplies", fields: [vendorId], references: [id], onDelete: Cascade)
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  body            String         @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([productReviewId])
  @@unique([shopReviewId])
  @@index([vendorId])
}

model ReviewReport {
  id              String             @id @default(uuid())
  productReviewId String?
  productReview   ProductReview?     @relation(fields: [productReviewId], references: [id], onDelete: Cascade)
  shopReviewId    String?
  shopReview      ShopReview?        @relation(fields: [shopReviewId], references: [id], onDelete: Cascade)
  reporterId      String
  reporter        User               @relation("ReviewReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reason          String             @db.Text
  status          ReviewReportStatus @default(OPEN)
  resolvedById    String?
  resolvedBy      User?              @relation("ReviewReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolution      String?            @db.Text
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([productReviewId, reporterId])
  @@unique([shopReviewId, reporterId])
  @@index([status, createdAt])
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model RecentlyViewed {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now()) @updatedAt

  @@unique([userId, productId])
  @@index([userId, viewedAt])
}

// ==========================================
// THREE-TIER MULTI-VENDOR ORDER ENGINE
// ==========================================

model Order {
  id         String @id @default(uuid())
  customerId String
  customer   User   @relation("CustomerOrders", fields: [customerId], references: [id])

  orderNumber   String  @unique
  totalAmount   Decimal @db.Decimal(18, 2)
  currency      String  @db.VarChar(3)
  subTotal      Decimal @db.Decimal(18, 2)
  totalShipping Decimal @db.Decimal(18, 2)
  taxAmount     Decimal @default(0.00) @db.Decimal(18, 2)

  status         OrderStatus    @default(PENDING)
  paymentGateway PaymentGateway
  paymentStatus  PaymentStatus  @default(PENDING)

  gatewayReference    String?           @unique
  checkoutRequestId   String?
  checkoutRequestHash String?
  paymentAttempts     PaymentAttempt[]
  ledgerEntries       FinancialLedger[]
  shippingAddress     String
  shippingPhone       String
  shippingEmail       String
  notes               String?

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  subOrders  SubOrder[]
  orderItems OrderItem[]
  refunds    Refund[]
  disputes   Dispute[]
  riskFlags  RiskFlag[]

  @@unique([customerId, checkoutRequestId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model SubOrder {
  id       String        @id @default(uuid())
  orderId  String
  order    Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorId String
  vendor   VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  subOrderNumber       String            @unique
  vendorSubTotal       Decimal           @db.Decimal(18, 2)
  vendorShipping       Decimal           @db.Decimal(18, 2)
  vendorTotal          Decimal           @db.Decimal(18, 2)
  platformCommission   Decimal           @db.Decimal(18, 2)
  commissionRate       Decimal?          @db.Decimal(5, 2)
  vendorNetEntitlement Decimal?          @db.Decimal(18, 2)
  paymentProcessingFee Decimal           @default(0.00) @db.Decimal(18, 2)
  ledgerEntries        FinancialLedger[]

  status                     SubOrderStatus              @default(PENDING)
  deliveryConfirmedAt        DateTime?
  deliveryConfirmedByUserId  String?
  deliveryConfirmationSource DeliveryConfirmationSource?
  notes                      String?
  fulfillmentMethod          FulfillmentMethod            @default(DELIVERY)
  fulfillmentSnapshot        Json?
  refundPolicySnapshot       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items          OrderItem[]
  returnRequests ReturnRequest[]
  refunds        Refund[]
  disputes       Dispute[]
  riskFlags      RiskFlag[]
  shopReview     ShopReview?

  @@index([orderId])
  @@index([vendorId])
  @@index([status])
}

model PaymentAttempt {
  id                  String               @id @default(uuid())
  orderId             String
  order               Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  gateway             PaymentGateway
  merchantReference   String               @unique @db.VarChar(50)
  initiationRequestId String?              @unique @db.VarChar(128)
  redirectUrl         String?              @db.Text
  providerTrackingId  String?              @unique @db.VarChar(191)
  amount              Decimal              @db.Decimal(18, 2)
  currency            String               @db.VarChar(3)
  status              PaymentAttemptStatus @default(CREATED)
  providerStatus      String?
  confirmationCode    String?
  paymentMethod       String?
  providerPayload     Json?
  initiatedAt         DateTime?
  verifiedAt          DateTime?
  completedAt         DateTime?
  orderCompletedAt    DateTime?
  reversedAt          DateTime?
  lastVerifiedAt      DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  ledgerEntries       FinancialLedger[]
  refunds             Refund[]

  @@index([orderId])
  @@index([status])
}

model OrderItem {
  id         String          @id @default(uuid())
  orderId    String
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subOrderId String
  subOrder   SubOrder        @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id])
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id])

  quantity        Int     @default(1)
  priceAtPurchase Decimal @db.Decimal(18, 2)
  totalPrice      Decimal @db.Decimal(18, 2)
  productNameSnapshot String?
  variantNameSnapshot String?
  variantOptionsSnapshot Json?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  returnItems ReturnItem[]
  refundItems RefundItem[]
  productReview ProductReview?

  @@index([orderId])
  @@index([subOrderId])
  @@index([productId])
}

// ==========================================
// VENDOR EARNINGS & ESCROW LEDGERS
// ==========================================

model FinancialLedger {
  id                String                   @id @default(uuid())
  vendorId          String
  vendor            VendorProfile            @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  orderId           String?
  order             Order?                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  subOrderId        String?
  subOrder          SubOrder?                @relation(fields: [subOrderId], references: [id], onDelete: Restrict)
  paymentAttemptId  String?
  paymentAttempt    PaymentAttempt?          @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  vendorPayoutId    String?
  vendorPayout      VendorPayout?            @relation(fields: [vendorPayoutId], references: [id], onDelete: Restrict)
  type              LedgerTransactionType
  walletBucket      WalletBucket?
  amount            Decimal                  @db.Decimal(18, 2)
  currency          String?                  @db.VarChar(3)
  reference         String?
  description       String?
  createdAt         DateTime                 @default(now())
  payoutAllocations VendorPayoutAllocation[]
  refundId          String?
  refund            Refund?                  @relation(fields: [refundId], references: [id], onDelete: Restrict)

  @@unique([refundId, type])
  @@unique([vendorPayoutId, type])
  @@index([vendorId, currency, walletBucket])
  @@index([orderId])
  @@index([paymentAttemptId])
  @@index([vendorPayoutId])
}

model ReturnRequest {
  id                String       @id @default(uuid())
  subOrderId        String
  subOrder          SubOrder     @relation(fields: [subOrderId], references: [id], onDelete: Restrict)
  requestedByUserId String
  requestedBy       User         @relation("ReturnRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  status            ReturnStatus @default(REQUESTED)
  reason            String       @db.Text
  receivedAt        DateTime?
  completedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  items             ReturnItem[]
  refund            Refund?

  @@index([subOrderId, status])
  @@index([requestedByUserId])
}

model ReturnItem {
  id              String        @id @default(uuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItemId     String
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  quantity        Int
  restockedAt     DateTime?

  @@unique([returnRequestId, orderItemId])
  @@index([orderItemId])
}

model Refund {
  id                           String            @id @default(uuid())
  orderId                      String
  order                        Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  subOrderId                   String
  subOrder                     SubOrder          @relation(fields: [subOrderId], references: [id], onDelete: Restrict)
  paymentAttemptId             String?
  paymentAttempt               PaymentAttempt?   @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  returnRequestId              String?           @unique
  returnRequest                ReturnRequest?    @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)
  requestedByUserId            String
  requestedBy                  User              @relation("RefundRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  approvedByUserId             String?
  approvedBy                   User?             @relation("RefundApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  amount                       Decimal           @db.Decimal(18, 2)
  platformCommissionAdjustment Decimal           @default(0) @db.Decimal(18, 2)
  vendorLiabilityAdjustment    Decimal           @default(0) @db.Decimal(18, 2)
  shippingAmount               Decimal           @default(0) @db.Decimal(18, 2)
  gatewayFeeAdjustment         Decimal           @default(0) @db.Decimal(18, 2)
  currency                     String            @db.VarChar(3)
  reason                       String            @db.Text
  status                       RefundStatus      @default(REQUESTED)
  approvedAt                   DateTime?
  completedAt                  DateTime?
  createdAt                    DateTime          @default(now())
  updatedAt                    DateTime          @updatedAt
  ledgerEntries                FinancialLedger[]
  items                        RefundItem[]

  @@index([subOrderId, status])
  @@index([orderId])
  @@index([paymentAttemptId])
}

model Dispute {
  id               String        @id @default(uuid())
  customerId       String
  customer         User          @relation("DisputeCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  orderId          String
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  subOrderId       String
  subOrder         SubOrder      @relation(fields: [subOrderId], references: [id], onDelete: Restrict)
  vendorId         String
  vendor           VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  reason           String
  description      String        @db.Text
  status           DisputeStatus @default(OPEN)
  openedAt         DateTime      @default(now())
  resolvedAt       DateTime?
  resolvedByUserId String?
  resolvedBy       User?         @relation("DisputeResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  resolution       String?       @db.Text
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([customerId, createdAt])
  @@index([vendorId, status])
  @@index([subOrderId, status])
  @@index([orderId])
}

model RiskFlag {
  id               String           @id @default(uuid())
  scope            RiskFlagScope
  category         RiskFlagCategory
  source           RiskFlagSource   @default(ADMIN)
  severity         RiskSeverity
  status           RiskFlagStatus   @default(OPEN)
  reason           String           @db.Text
  customerId       String?
  customer         User?            @relation("RiskFlagCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  vendorId         String?
  vendor           VendorProfile?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  orderId          String?
  order            Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  subOrderId       String?
  subOrder         SubOrder?        @relation(fields: [subOrderId], references: [id], onDelete: SetNull)
  payoutId         String?
  payout           VendorPayout?    @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  createdByUserId  String
  createdBy        User             @relation("RiskFlagCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  resolvedByUserId String?
  resolvedBy       User?            @relation("RiskFlagResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  resolvedAt       DateTime?
  resolution       String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, severity])
  @@index([vendorId, status])
  @@index([subOrderId, status])
  @@index([orderId, status])
  @@index([payoutId, status])
}

model RefundItem {
  id          String    @id @default(uuid())
  refundId    String
  refund      Refund    @relation(fields: [refundId], references: [id], onDelete: Restrict)
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  quantity    Int
  grossAmount Decimal   @db.Decimal(18, 2)
  createdAt   DateTime  @default(now())

  @@unique([refundId, orderItemId])
  @@index([orderItemId])
}

model VendorPayout {
  id       String        @id @default(uuid())
  vendorId String
  vendor   VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  amount              Decimal                @db.Decimal(18, 2)
  currency            String?                @db.VarChar(3)
  withdrawalRequestId String?
  requestHash         String?
  destinationType     PayoutDestinationType?
  maskedDestination   String?
  requestedByUserId   String?
  approvedByUserId    String?
  rejectedByUserId    String?
  cancelledByUserId   String?
  approvedAt          DateTime?
  rejectedAt          DateTime?
  cancelledAt         DateTime?
  readyAt             DateTime?
  merchantReference   String?                @unique
  gateway             PaymentGateway?
  reference           String?
  status              PayoutStatus           @default(PENDING)
  errorMessage        String?

  processedAt   DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  ledgerEntries FinancialLedger[]
  allocations   VendorPayoutAllocation[]
  riskFlags     RiskFlag[]

  @@unique([vendorId, withdrawalRequestId])
  @@index([vendorId])
  @@index([status])
}

model VendorPayoutAllocation {
  id              String                 @id @default(uuid())
  vendorPayoutId  String
  vendorPayout    VendorPayout           @relation(fields: [vendorPayoutId], references: [id], onDelete: Restrict)
  earningLedgerId String
  earningLedger   FinancialLedger        @relation(fields: [earningLedgerId], references: [id], onDelete: Restrict)
  vendorId        String
  currency        String                 @db.VarChar(3)
  allocatedAmount Decimal                @db.Decimal(18, 2)
  status          PayoutAllocationStatus @default(ACTIVE)
  releasedAt      DateTime?
  createdAt       DateTime               @default(now())

  @@unique([vendorPayoutId, earningLedgerId])
  @@index([earningLedgerId, status])
  @@index([vendorId, currency, status])
}

// ==========================================
// PLATFORM VENDOR SUBSCRIPTIONS
// ==========================================

model SubscriptionPlan {
  id           String       @id @default(uuid())
  name         String       @unique
  slug         String       @unique
  description  String?
  price        Decimal      @db.Decimal(18, 2)
  currency     String       @default("UGX")
  billingCycle BillingCycle @default(MONTHLY)

  maxProducts       Int?
  commissionRate    Decimal @db.Decimal(5, 2)
  hasPremiumThemes  Boolean @default(false)
  hasAdvancedCharts Boolean @default(false)
  isActive          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions VendorSubscription[]
}

model VendorSubscription {
  id       String           @id @default(uuid())
  vendorId String
  vendor   VendorProfile    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  planId   String
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])

  status             SubscriptionStatus @default(TRIAL)
  startedAt          DateTime           @default(now())
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelledAt        DateTime?
  gracePeriodEndsAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@index([status])
}

// ==========================================
// SYSTEM ENGINE, AUDIT LOGS, INTEGRATIONS
// ==========================================

model Notification {
  id       String         @id @default(uuid())
  vendorId String?
  vendor   VendorProfile? @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      NotificationType @default(INFO)
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([vendorId])
  @@index([userId])
  @@index([readAt])
}

model Document {
  id       String         @id @default(uuid())
  vendorId String?
  vendor   VendorProfile? @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  type      DocumentType @default(OTHER)
  name      String
  url       String
  mimeType  String?
  size      Int?
  createdAt DateTime     @default(now())

  @@index([vendorId])
}

model AuditLog {
  id       String         @id @default(uuid())
  vendorId String?
  vendor   VendorProfile? @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  action    String
  entity    String
  entityId  String?
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([vendorId])
  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

model PesapalIpnRegistry {
  id          String   @id @default(uuid())
  ipnId       String   @unique
  url         String
  environment String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ipnId])
}

model PaymentGatewayWebhookLog {
  id           String               @id @default(uuid())
  gateway      PaymentGateway
  trackingId   String
  reference    String
  eventType    String?
  payload      Json
  status       WebhookProcessStatus @default(UNPROCESSED)
  errorMessage String?
  createdAt    DateTime             @default(now())

  @@index([trackingId])
  @@index([reference])
  @@index([status])
}

model ReconciliationFinding {
  id               String                      @id @default(uuid())
  type             String
  domain           ReconciliationDomain
  severity         ReconciliationSeverity
  entityType       String
  entityId         String
  vendorId         String?
  orderId          String?
  subOrderId       String?
  paymentAttemptId String?
  vendorPayoutId   String?
  refundId         String?
  status           ReconciliationFindingStatus @default(OPEN)
  detectedAt       DateTime                    @default(now())
  resolvedAt       DateTime?
  resolution       String?
  metadata         Json?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  @@unique([type, entityType, entityId])
  @@index([status, severity])
  @@index([domain, status])
  @@index([vendorId, status])
}

# Server-side database and session configuration
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/smartduka"
# Canonical deployed application origin, for example https://your-production-host.example
NEXT_PUBLIC_APP_URL=
JWT_SECRET="generate-a-unique-random-secret-of-at-least-32-characters"
CRON_SECRET="generate-a-separate-random-secret"
# Base64-encoded, 32-byte server-only AES-256-GCM key for vendor payout references.
VENDOR_PAYOUT_ENCRYPTION_KEY=
MARKETING_IN_APP_DAILY_LIMIT=2

# Standards-based PWA Web Push. Generate stable VAPID keys outside the app
# (`npx web-push generate-vapid-keys`) and store them in your deployment secret manager.
# Never expose WEB_PUSH_VAPID_PRIVATE_KEY or WEB_PUSH_SUBSCRIPTION_ENCRYPTION_KEY.
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT="mailto:security@example.com"
# Base64-encoded 32-byte AES-256-GCM key; generate once with a secret manager.
WEB_PUSH_SUBSCRIPTION_ENCRYPTION_KEY=

# Direct customer-to-vendor payment providers. Pesapal remains available for
# historical reconciliation only and is disabled for new checkout by default.
PAYMENTS_MTN_ENABLED=false
PAYMENTS_AIRTEL_ENABLED=false
PAYMENTS_PESAPAL_ENABLED=false

# ============================================================
# MTN MOMO — MARKETPLACE CUSTOMER PAYMENTS
# Customer -> Vendor
# ============================================================

# Base/provider configuration. PAYMENTS_MTN_ENABLED is the current marketplace
# gate; MTN_MOMO_ENABLED is a legacy fallback and should remain false.
MTN_MOMO_ENABLED=false
MTN_MOMO_ENVIRONMENT=sandbox
MTN_MOMO_BASE_URL=
MTN_MOMO_COLLECTION_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_CALLBACK_URL=
MTN_MOMO_CALLBACK_HOST=

# Marketplace routing qualification. Never set either flag until the telecom
# contract proves each RequestToPay settles to the named vendor.
MTN_MOMO_DIRECT_VENDOR_ROUTING_VERIFIED=false
MTN_DIRECT_VENDOR_ROUTING_VERIFIED=false

# Sandbox qualification only; ignored outside MTN_MOMO_ENVIRONMENT=sandbox.
MTN_SANDBOX_COLLECTION_TESTING_ENABLED=false
MTN_SANDBOX_RECONCILIATION_QUALIFICATION_ENABLED=false
MTN_SANDBOX_TEST_MSISDN=
MTN_SANDBOX_TEST_CURRENCY=EUR
MTN_SANDBOX_TEST_AMOUNT=100
# Standalone qualification uses status polling by default; set true only to test callbacks.
MTN_SANDBOX_TEST_USE_CALLBACK=false
# Set true only after a real marketplace provider callback has been verified.
MTN_MOMO_REAL_CALLBACK_DELIVERY_VERIFIED=false

AIRTEL_MONEY_ENVIRONMENT=sandbox
AIRTEL_MONEY_BASE_URL=
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
AIRTEL_MONEY_CALLBACK_URL=
AIRTEL_MONEY_DIRECT_VENDOR_ROUTING_VERIFIED=false

# ============================================================
# SMARTDUKA PLATFORM REVENUE — MTN MOMO
# Vendor -> SmartDuka
# ============================================================

# Base/provider configuration. This gate is independent of marketplace MTN.
PLATFORM_PAYMENTS_MTN_ENABLED=false
PLATFORM_MTN_ENVIRONMENT=sandbox
PLATFORM_MTN_BASE_URL=
PLATFORM_MTN_COLLECTION_SUBSCRIPTION_KEY=
PLATFORM_MTN_API_USER=
PLATFORM_MTN_API_KEY=
PLATFORM_MTN_TARGET_ENVIRONMENT=sandbox

# Temporary or configured SmartDuka platform-revenue merchant destination.
# Used for Vendor -> SmartDuka payments only. Never use it for marketplace
# Customer -> Vendor routing.
PLATFORM_MTN_MERCHANT_ID=
PLATFORM_MTN_MERCHANT_CODE=

# Sandbox qualification only. This explicit safety gate defaults to disabled.
PLATFORM_MTN_SANDBOX_TESTING_ENABLED=false
PLATFORM_MTN_SANDBOX_TEST_VENDOR_ID=
PLATFORM_MTN_SANDBOX_TEST_MSISDN=
PLATFORM_MTN_SANDBOX_TEST_CURRENCY=EUR
PLATFORM_MTN_SANDBOX_TEST_AMOUNT=100

# Controlled real-money qualification only. Enabling this does not enable
# PLATFORM_MTN_PRODUCTION_ENABLED; production charging remains separately gated.
PLATFORM_MTN_LIVE_TEST_ENABLED=false
PLATFORM_MTN_LIVE_TEST_CONFIRM_REAL_MONEY=false
PLATFORM_MTN_LIVE_TEST_VENDOR_ID=
# Supply a fresh, safe qualification ID through this environment variable; it
# is not a CLI argument and is reused only to reconcile the same test charge.
PLATFORM_MTN_LIVE_TEST_QUALIFICATION_ID=
PLATFORM_MTN_LIVE_TEST_MSISDN=
PLATFORM_MTN_LIVE_TEST_AMOUNT=
PLATFORM_MTN_LIVE_TEST_CURRENCY=UGX
# Set only after observing a real provider callback; polling remains authoritative.
PLATFORM_MTN_LIVE_TEST_CALLBACK_VERIFIED=false

# Production rollout gate. Keep false until platform production charging is approved.
PLATFORM_MTN_PRODUCTION_ENABLED=false

# ============================================================
# SMARTDUKA REVENUE PRODUCT SETTINGS
# ============================================================

# Vendor trial and promotional credit.
VENDOR_TRIAL_DAYS=30
PROMOTIONAL_CREDIT_UGX=30000
PROMOTIONAL_CREDIT_EXPIRY_DAYS=30

# Promotion pricing. Subscription plan prices are authoritative in
# SubscriptionPlan database records seeded by scripts/seed-subscription-plans.mjs.
PRODUCT_PROMOTION_DAILY_RATE_UGX=10000
SHOP_PROMOTION_DAILY_RATE_UGX=20000

# Firebase server credentials (never expose FIREBASE_PRIVATE_KEY to the browser)
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@example.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"

# Public Firebase browser configuration
NEXT_PUBLIC_FIREBASE_API_KEY="replace-me"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="replace-me"
NEXT_PUBLIC_FIREBASE_APP_ID="replace-me"

# Public Supabase browser configuration. Do not use a service-role key here.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-me"

# Server-only Supabase Storage credential. Never prefix it with NEXT_PUBLIC_.
# Prefer SUPABASE_SECRET_KEY; SUPABASE_SERVICE_ROLE_KEY is supported for legacy projects.
SUPABASE_SECRET_KEY="replace-me"
SUPABASE_SERVICE_ROLE_KEY="replace-me"

# Pesapal API 3.0 server-only configuration
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=
PESAPAL_IPN_URL=
PESAPAL_CALLBACK_URL=
PESAPAL_CANCELLATION_URL=

# Controlled test marketplace seed. Never commit real passwords or enable these by default.
ALLOW_TEST_MARKETPLACE_SEED=false
ALLOW_PRODUCTION_TEST_SEED=false
TEST_VENDOR_1_EMAIL=
TEST_VENDOR_1_PASSWORD=
TEST_VENDOR_2_EMAIL=
TEST_VENDOR_2_PASSWORD=
TEST_CUSTOMER_EMAIL=
TEST_CUSTOMER_PASSWORD=
# Destructive test-data cleanup is unconditionally denied in production.
# External Firebase/storage cleanup also requires an explicit non-production opt-in.
TEST_DATA_ENVIRONMENT="DEVELOPMENT"
ENABLE_TEST_DATA_EXTERNAL_CLEANUP="false"
ALLOW_PRODUCTION_TEST_DATA_REGISTRATION="false"
